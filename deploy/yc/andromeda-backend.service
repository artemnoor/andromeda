[Unit]
Description=Andromeda FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/andromeda/release/backend
Environment=PYTHONPATH=/opt/andromeda/release/backend/src
Environment=ANDROMEDA_ENV=test
Environment=BMSTU_DATABASE_URL=sqlite:////opt/andromeda/data/tracer.db
Environment=VITE_FRONTEND_ORIGIN=http://127.0.0.1
Environment=LOG_LEVEL=INFO
Environment=BMSTU_DB_POOL_SIZE=1
Environment=BMSTU_DB_MAX_OVERFLOW=0
ExecStart=/opt/andromeda/venv/bin/uvicorn andromeda.api.main:app --host 127.0.0.1 --port 8020
Restart=on-failure
RestartSec=5
User=andromeda
Group=andromeda
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
