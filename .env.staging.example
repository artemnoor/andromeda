ANDROMEDA_ENV=staging
BMSTU_DATABASE_URL=postgresql+psycopg://andromeda:change-me@127.0.0.1:5433/andromeda_staging
VITE_FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
ANDROMEDA_PROFILE_COOKIE_NAME=andromeda_profile_session
ANDROMEDA_PROFILE_COOKIE_MAX_AGE=2592000
ANDROMEDA_PROFILE_TTL_SECONDS=2592000
ANDROMEDA_PROFILE_COOKIE_SECURE=true
ANDROMEDA_PROFILE_COOKIE_SAMESITE=lax
# Optional read-only Admin/Ops access; leave unset to keep the endpoint disabled.
# ANDROMEDA_OPS_API_KEY=replace-with-a-secret

ANDROMEDA_STAGING_DB=andromeda_staging
ANDROMEDA_STAGING_DB_USER=andromeda
ANDROMEDA_STAGING_DB_PASSWORD=change-me
ANDROMEDA_STAGING_PORT=5433
